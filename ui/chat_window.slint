import { Button, ScrollView, ListView } from "std-widgets.slint";
import { SessionItem, CharacterItem, ChatMessageData } from "chat/types.slint";
import { AssistantBubble } from "chat/assistant_bubble.slint";
import { ChatSidebar } from "chat/sidebar.slint";
import { ChatInputBar } from "chat/input_bar.slint";
import {
    ChatCharacterDropdown,
    ChatMessageContextMenu,
    ChatSessionContextMenu,
    ChatRenameDialog
} from "chat/chat_dialogs.slint";

export { SessionItem, CharacterItem, ChatMessageData }

export component ChatWindow inherits Window {
    title: "桌宠 聊天窗口";
    icon: @image-url("../assets/icons/app_icon.png");
    always-on-top: false;
    preferred-width: 820px;
    preferred-height: 580px;
    min-width: 620px;
    min-height: 440px;
    background: #13141f;

    // Multi-character properties
    in-out property <image> character_avatar: @image-url("../assets/icons/bot.svg");
    in-out property <string> active_character_name: "丛雨";
    in-out property <string> active_character_id: "murasame";
    in-out property <[CharacterItem]> character_list: [];
    in-out property <bool> char_switcher_open: false;

    // User avatar properties
    in-out property <image> user_avatar: @image-url("../assets/user_avatar.png");
    in-out property <bool> user_avatar_enabled: true;

    in-out property <bool> sidebar_collapsed: true;
    in-out property <[SessionItem]> sessions: [];
    in-out property <string> active_session_id: "";
    in-out property <string> active_session_title: "新会话";
    in-out property <string> active_protocol: "hermes";
    in-out property <[ChatMessageData]> messages: [];
    in-out property <bool> is_generating: false;
    in-out property <string> agent_status_text: "";
    in-out property <string> input_text: "";
    in-out property <length> chat_area_width: root.sidebar_collapsed ? root.width : (root.width - 230px);
    in-out property <bool> sticky_bottom: true;
    private property <length> prev_content_y: 0px;
    private property <length> prev_content_height: 0px;

    // Context menu & Rename dialog state
    in-out property <bool> context_menu_open: false;
    in-out property <length> menu_x: 0px;
    in-out property <length> menu_y: 0px;
    in-out property <string> target_menu_session_id: "";
    in-out property <string> target_menu_session_title: "";
    in-out property <bool> rename_dialog_open: false;
    in-out property <string> rename_input_text: "";

    // Message context menu state
    in-out property <bool> msg_menu_open: false;
    in-out property <length> msg_menu_x: 0px;
    in-out property <length> msg_menu_y: 0px;
    in-out property <string> target_msg_raw_text: "";

    callback copy_to_clipboard(string);
    callback new_session();
    callback select_session(string);
    callback delete_session(string);
    callback rename_session(string, string);
    callback clear_session(string);
    callback send_message(string);
    callback toggle_sidebar();
    callback switch_character(string);

    public function force_scroll_to_bottom() {
        root.sticky_bottom = true;
        if msg_list.content-height > msg_list.visible-height {
            msg_list.content-y = msg_list.visible-height - msg_list.content-height;
        } else {
            msg_list.content-y = 0px;
        }
        root.prev_content_y = msg_list.content-y;
        root.prev_content_height = msg_list.content-height;
    }

    public function scroll_to_bottom() {
        if root.sticky_bottom {
            root.force_scroll_to_bottom();
        }
    }

    HorizontalLayout {

    HorizontalLayout {
        // 1. Collapsible Left Sidebar
        if !root.sidebar_collapsed : ChatSidebar {
            character_avatar: root.character_avatar;
            active_character_name: root.active_character_name;
            char_switcher_open <=> root.char_switcher_open;
            sessions: root.sessions;
            window_height: root.height;

            toggle_sidebar => {
                root.sidebar_collapsed = true;
                root.toggle_sidebar();
            }
            open_char_switcher => {
                root.char_switcher_open = !root.char_switcher_open;
            }
            new_session => {
                root.new_session();
            }
            select_session(id) => {
                root.select_session(id);
            }
            delete_session(id) => {
                root.delete_session(id);
            }
            open_session_context_menu(x, y, id, title) => {
                root.menu_x = x;
                root.menu_y = y;
                root.target_menu_session_id = id;
                root.target_menu_session_title = title;
                root.context_menu_open = true;
            }
            force_scroll_to_bottom => {
                root.force_scroll_to_bottom();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #13141f;

            VerticalLayout {
                width: 100%;
                height: 100%;

                // Message Scroll Stream (Virtualized List with dynamic item width and text wrapping)
                msg_list := ListView {
                    vertical-stretch: 1;

                    for msg in root.messages : item := VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 6px;
                        padding-bottom: 6px;

                        if msg.role == "user" : HorizontalLayout {
                            alignment: end;
                            spacing: 8px;

                            Rectangle {
                                max-width: root.chat_area_width * 0.75;
                                background: #23263b;
                                border-width: 1px;
                                border-color: #659fae55;
                                border-radius: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;

                                    Text {
                                        text: msg.raw_text;
                                        color: #ffffff;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                    }
                                }

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                            root.target_msg_raw_text = msg.raw_text;
                                            root.msg_menu_x = Math.max(10px, Math.min(self.absolute-position.x + self.mouse-x, root.width - 110px));
                                            root.msg_menu_y = Math.max(10px, Math.min(self.absolute-position.y + self.mouse-y, root.height - 48px));
                                            root.msg_menu_open = true;
                                            root.context_menu_open = false;
                                        }
                                    }
                                }
                            }

                            if root.user_avatar_enabled : VerticalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: #2a2d45;
                                    border-width: 1px;
                                    border-color: #659fae44;
                                    clip: true;
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.user_avatar;
                                    }
                                }
                            }
                        }

                        if msg.role != "user" : HorizontalLayout {
                            alignment: start;
                            spacing: 10px;

                            // Character Avatar icon
                            VerticalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: #659fae28;
                                    border-width: 1px;
                                    border-color: #659fae66;
                                    clip: true;
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.character_avatar;
                                    }
                                }
                            }

                            // Message bubble with collapsible accordion for thoughts & tools
                            AssistantBubble {
                                max-width: root.chat_area_width * 0.82;
                                msg: msg;
                                right_clicked(x, y, raw) => {
                                    root.target_msg_raw_text = raw;
                                    root.msg_menu_x = Math.max(10px, Math.min(x, root.width - 110px));
                                    root.msg_menu_y = Math.max(10px, Math.min(y, root.height - 48px));
                                    root.msg_menu_open = true;
                                    root.context_menu_open = false;
                                }
                            }
                        }
                    }
                }

                // Agent status / Tool execution indicator banner
                if root.agent_status_text != "" : Rectangle {
                    height: 32px;
                    background: #1e2030ee;
                    border-width: 1px;
                    border-color: #659fae44;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: start;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 14px;
                                height: 14px;
                                source: @image-url("../assets/icons/tool.svg");
                            }
                        }

                        Text {
                            text: root.agent_status_text;
                            color: #659fae;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                ChatInputBar {
                    input_text <=> root.input_text;
                    is_generating: root.is_generating;
                    send_message(text) => {
                        root.send_message(text);
                    }
                    force_scroll_to_bottom => {
                        root.force_scroll_to_bottom();
                    }
                }
            }

            if root.sidebar_collapsed : Rectangle {
                x: 10px;
                y: 7px;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: expand_btn.has-hover ? #ffffff22 : #1e2030cc;
                border-width: 1px;
                border-color: #ffffff20;

                expand_btn := TouchArea {
                    clicked => {
                        root.sidebar_collapsed = false;
                        root.toggle_sidebar();
                    }
                }
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("../assets/icons/chevron_right.svg");
                }
            }

        }
    }

    // Modal Overlays
    if root.char_switcher_open : ChatCharacterDropdown {
        width: 100%;
        height: 100%;
        active_character_id: root.active_character_id;
        character_list: root.character_list;
        close => { root.char_switcher_open = false; }
        switch_character(id) => {
            root.force_scroll_to_bottom();
            root.switch_character(id);
        }
    }

    if root.msg_menu_open : ChatMessageContextMenu {
        width: 100%;
        height: 100%;
        menu_x: root.msg_menu_x;
        menu_y: root.msg_menu_y;
        raw_text: root.target_msg_raw_text;
        close => { root.msg_menu_open = false; }
        copy_to_clipboard(text) => {
            root.copy_to_clipboard(text);
        }
    }

    if root.context_menu_open : ChatSessionContextMenu {
        width: 100%;
        height: 100%;
        menu_x: root.menu_x;
        menu_y: root.menu_y;
        session_id: root.target_menu_session_id;
        session_title: root.target_menu_session_title;
        close => { root.context_menu_open = false; }
        open_rename_dialog => {
            root.rename_input_text = root.target_menu_session_title;
            root.rename_dialog_open = true;
        }
        clear_session(id) => {
            root.clear_session(id);
        }
        delete_session(id) => {
            root.delete_session(id);
        }
    }

    if root.rename_dialog_open : ChatRenameDialog {
        width: 100%;
        height: 100%;
        rename_input_text <=> root.rename_input_text;
        session_id: root.target_menu_session_id;
        close => { root.rename_dialog_open = false; }
        rename_session(id, title) => {
            root.rename_session(id, title);
        }
    }
}
}
