import { CharacterItem } from "../chat_window.slint";
import { ScrollView } from "std-widgets.slint";

export component MainContextMenu inherits Rectangle {
    background: transparent;

    in property <length> menu_x: 0px;
    in property <length> menu_y: 0px;
    in-out property <bool> char_menu_open: false;
    in property <[CharacterItem]> character_list: [];
    in property <bool> mouse_passthrough: false;
    in-out property <bool> chat_open: false;

    callback close();
    callback open_chat_window();
    callback open_settings();
    callback toggle_chat();
    callback switch_character(string);
    callback scale_changed(float);
    callback reset_scale();
    callback toggle_mouse_passthrough();
    callback minimize_to_tray();
    callback exit_app();

    TouchArea {
        clicked => {
            root.close();
        }
    }

        // Clicking outside closes the menu
        TouchArea {
            clicked => {
                root.close();
                root.char_menu_open = false;
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.close();
                    root.char_menu_open = false;
                }
            }
        }

        menu_card := Rectangle {
            x: root.menu_x;
            y: Math.max(10px, Math.min(root.menu_y, root.height - menu_layout.preferred-height - 10px));
            width: 176px;
            height: menu_layout.preferred-height;
            border-radius: 10px;
            background: #161726f5;
            border-width: 1px;
            border-color: #659fae44;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000099;

            menu_layout := VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;

                // Chat Toggle Item
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_chat_touch.has-hover ? #659fae28 : transparent;
                    item_chat_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.chat_open = !root.chat_open;
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: root.chat_open ? "收起简易输入" : "快速对话";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Full Chat Window Item
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_chat_win_touch.has-hover ? #659fae28 : transparent;
                    item_chat_win_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.open_chat_window();
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "聊天窗口";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Character Switch Submenu Item
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: (item_chars_touch.has-hover || root.char_menu_open) ? #659fae28 : transparent;
                    item_chars_touch := TouchArea {
                        clicked => {
                            root.char_menu_open = !root.char_menu_open;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;
                        Text {
                            horizontal-stretch: 1;
                            text: "切换角色";
                            color: #ffffff;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 12px;
                                height: 12px;
                                source: root.char_menu_open ? @image-url("../../assets/icons/chevron_down.svg") : @image-url("../../assets/icons/chevron_right.svg");
                            }
                        }
                    }
                }

                // Separator
                Rectangle { height: 1px; background: #ffffff14; }

                // Zoom in
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_zoom_in_touch.has-hover ? #659fae28 : transparent;
                    item_zoom_in_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.scale_changed(0.1);
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "放大桌宠 (+10%)";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Zoom out
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_zoom_out_touch.has-hover ? #659fae28 : transparent;
                    item_zoom_out_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.scale_changed(-0.1);
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "缩小桌宠 (-10%)";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Reset zoom
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_zoom_reset_touch.has-hover ? #659fae28 : transparent;
                    item_zoom_reset_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.reset_scale();
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "重置大小 (100%)";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Separator
                Rectangle { height: 1px; background: #ffffff14; }

                // Mouse passthrough
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_pt_touch.has-hover ? #659fae28 : transparent;
                    item_pt_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.toggle_mouse_passthrough();
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: root.mouse_passthrough ? "关闭鼠标穿透" : "开启鼠标穿透";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Settings
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_cfg_touch.has-hover ? #659fae28 : transparent;
                    item_cfg_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.open_settings();
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "设置";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Minimize
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_min_touch.has-hover ? #659fae28 : transparent;
                    item_min_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.minimize_to_tray();
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "最小化至系统托盘";
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Separator
                Rectangle { height: 1px; background: #ffffff14; }

                // Exit app
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: item_exit_touch.has-hover ? #ef444433 : transparent;
                    item_exit_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.exit_app();
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "退出程序";
                        color: item_exit_touch.has-hover ? #f87171 : #e2e8f0;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Character flyout submenu card
        if root.char_menu_open : Rectangle {
            x: (root.menu_x + 180px + 148px <= root.width) ? (root.menu_x + 180px) : Math.max(10px, root.menu_x - 154px);
            y: Math.max(10px, Math.min(root.menu_y + 40px, root.height - char_menu_layout.preferred-height - 10px));
            width: 148px;
            height: char_menu_layout.preferred-height;
            border-radius: 10px;
            background: #161726f5;
            border-width: 1px;
            border-color: #659fae44;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000099;

            char_menu_layout := VerticalLayout {
                padding: 5px;
                spacing: 2px;

                for ch in root.character_list : Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: ch.is_active ? #659fae33 : (ch_touch.has-hover ? #ffffff14 : transparent);
                    border-width: ch.is_active ? 1px : 0px;
                    border-color: #659fae88;

                    ch_touch := TouchArea {
                        clicked => {
                            root.close();
                            root.char_menu_open = false;
                            root.switch_character(ch.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        Text {
                            horizontal-stretch: 1;
                            text: ch.name;
                            color: ch.is_active ? #659fae : #ffffff;
                            font-size: 12px;
                            font-weight: ch.is_active ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if ch.is_active : VerticalLayout {
                            alignment: center;
                            Image {
                                width: 12px;
                                height: 12px;
                                source: @image-url("../../assets/icons/success.svg");
                            }
                        }
                    }
                }
            }
        }

}

export component MainErrorDialog inherits Rectangle {
    background: #000000a0;

    in property <string> title: "";
    in property <string> message: "";
    in-out property <string> copy_btn_text: "复制错误信息";

    callback close();
    callback copy_to_clipboard(string);

    TouchArea {}

        TouchArea {} // Block background clicks

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 24px, 340px);
            height: Math.min(parent.height - 40px, 240px);
            border-radius: 12px;
            background: #191a28;
            border-width: 1px;
            border-color: #ef444466;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000cc;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/error.svg");
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.title;
                        color: #f87171;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 22px; height: 22px;
                        border-radius: 11px;
                        background: close_main_err_touch.has-hover ? #ffffff22 : transparent;
                        close_main_err_touch := TouchArea {
                            clicked => { root.close(); }
                        }
                        Image {
                            width: 10px; height: 10px;
                            source: @image-url("../../assets/icons/close.svg");
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 6px;
                    background: #11121d;
                    border-width: 1px;
                    border-color: #ffffff14;

                    ScrollView {
                        width: 100%; height: 100%;
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: root.message;
                                color: #cbd5e1;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 100px;
                        height: 28px;
                        border-radius: 5px;
                        background: copy_main_err_touch.has-hover ? #659fae44 : #659fae22;
                        border-width: 1px;
                        border-color: #659fae66;
                        copy_main_err_touch := TouchArea {
                            clicked => {
                                root.copy_to_clipboard(root.message);
                                root.copy_btn_text = "已复制！";
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Image {
                                width: 12px; height: 12px;
                                source: @image-url("../../assets/icons/copy.svg");
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.copy_btn_text;
                                color: #659fae;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: 60px;
                        height: 28px;
                        border-radius: 5px;
                        background: close_main_btn_touch.has-hover ? #ffffff22 : #ffffff12;
                        close_main_btn_touch := TouchArea {
                            clicked => { root.close(); }
                        }
                        Text {
                            width: 100%; height: 100%;
                            text: "关闭";
                            color: #cccccc;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

}
