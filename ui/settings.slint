import { ScrollView } from "std-widgets.slint";
import { CharacterItem } from "chat_window.slint";
import { CueItem, McpServerItem, SkillItem } from "settings/types.slint";
import { StyledInput, StyledTextArea } from "settings/widgets.slint";
import { TabVoice } from "settings/tab_voice.slint";
import { TabLlm } from "settings/tab_llm.slint";
import { TabLive2d } from "settings/tab_live2d.slint";
import { TabUi } from "settings/tab_ui.slint";
import { TabUser } from "settings/tab_user.slint";
import { TabAgent } from "settings/tab_agent.slint";
import {
    CharacterDropdown,
    CharacterContextMenu,
    RenameCharacterDialog,
    CreateCharacterDialog,
    DeleteCharacterDialog
} from "settings/character_dialogs.slint";
import { AddMcpDialog } from "settings/mcp_dialog.slint";
import { ErrorDialog } from "settings/error_dialog.slint";

export { CueItem, McpServerItem, SkillItem, StyledInput, StyledTextArea }

export component SettingsWindow inherits Window {
    title: "桌宠 设置";
    icon: @image-url("../assets/icons/app_icon.png");
    always-on-top: true;
    preferred-width: 800px;
    preferred-height: 540px;
    min-width: 620px;
    min-height: 440px;
    background: #13141f;

    in-out property <int> active_tab: 0;

    // Multi-character selection & management
    in-out property <string> editing_char_id: "murasame";
    in-out property <string> editing_char_name: "丛雨";
    in-out property <image> editing_char_avatar: @image-url("../assets/icons/app_icon.png");
    in-out property <bool> editing_char_is_active: true;
    in-out property <[CharacterItem]> character_list: [];
    in-out property <bool> char_dropdown_open: false;

    // Create / Delete character modal state
    in-out property <bool> create_char_dialog_open: false;
    in-out property <string> new_char_name: "";
    in-out property <string> new_char_id: "";
    in-out property <bool> new_char_copy_current: true;
    in-out property <bool> delete_char_dialog_open: false;

    // Context menu & Rename character state
    in-out property <bool> char_context_menu_open: false;
    in-out property <length> char_menu_x: 0px;
    in-out property <length> char_menu_y: 0px;
    in-out property <string> target_menu_char_id: "";
    in-out property <string> target_menu_char_name: "";
    in-out property <bool> rename_char_dialog_open: false;
    in-out property <string> rename_char_input: "";

    // Global User Preferences
    in-out property <bool> cfg_user_avatar_enabled: true;
    in-out property <image> cfg_user_avatar: @image-url("../assets/user_avatar.png");

    callback select_editing_character(string);
    callback set_as_active_character(string);
    callback browse_character_avatar();
    callback browse_specific_char_avatar(string);
    callback rename_character(string, string);
    callback create_character(string, string, bool);
    callback delete_character(string);
    callback browse_user_avatar();
    callback reset_user_avatar();


    // TTS Preview Status & Error
    in-out property <string> tts_preview_status: "";
    in-out property <bool> tts_preview_is_error: false;

    // Edge-TTS Properties
    in-out property <bool> cfg_tts_enabled: true;
    in-out property <string> cfg_voice: "zh-CN-XiaoyiNeural";
    in-out property <bool> voice_dropdown_open: false;
    in-out property <[string]> voice_list: [
        "zh-CN-XiaoyiNeural",
        "zh-CN-XiaoxiaoNeural",
        "zh-CN-YunjianNeural",
        "zh-CN-YunxiNeural",
        "zh-CN-YunyangNeural",
        "zh-CN-YunfengNeural",
        "zh-CN-XiaozheNeural",
        "zh-CN-liaoning-XiaobeiNeural",
        "zh-CN-shaanxi-XiaoniNeural",
        "zh-CN-shandong-YunxiangNeural",
        "zh-CN-sichuan-YunxiNeural",
        "zh-HK-HiuMaanNeural",
        "zh-HK-WanLungNeural",
        "zh-TW-HsiaoChenNeural",
        "zh-TW-YunJheNeural",
        "ja-JP-NanamiNeural",
        "ja-JP-AoiNeural",
        "ja-JP-KeitaNeural",
        "en-US-AnaNeural",
        "en-US-JennyNeural",
        "en-US-GuyNeural"
    ];
    in-out property <float> cfg_tts_rate: 0.0;     // -50% 到 +100%
    in-out property <float> cfg_tts_pitch: 0.0;    // -50Hz 到 +50Hz
    in-out property <float> cfg_tts_volume: 0.0;   // -50% 到 +50%

    // Beatrice Properties
    in-out property <bool> cfg_beatrice_enabled: true;
    in-out property <string> cfg_beatrice_model_path: "C:\\Users\\Initsnow\\Documents\\eris-beatrice-v1";
    in-out property <string> beatrice_model_info: "未检测到模型";
    in-out property <[string]> beatrice_speakers: [];
    in-out property <int> cfg_speaker_id: 0;
    in-out property <string> current_speaker_name: "";
    in-out property <bool> speaker_dropdown_open: false;
    in-out property <float> cfg_pitch_shift: 0.0;
    in-out property <float> cfg_formant_shift: 0.0;
    in-out property <float> cfg_volume: 1.0;

    // AI / LLM Properties
    in-out property <string> cfg_api_protocol: "hermes";
    in-out property <string> cfg_hermes_url: "http://localhost:11434/v1";
    in-out property <string> cfg_hermes_key: "";
    in-out property <string> cfg_hermes_model: "murasame";
    in-out property <string> cfg_openai_url: "https://api.openai.com/v1";
    in-out property <string> cfg_openai_key: "";
    in-out property <string> cfg_openai_model: "deepseek-flash";
    in-out property <string> cfg_context_window: "300k";
    in-out property <string> cfg_compression_strategy: "truncate";
    in-out property <bool> model_dropdown_open: false;
    in-out property <bool> is_fetching_models: false;
    in-out property <string> fetch_models_status: "";
    in-out property <[string]> model_presets: [];
    in-out property <string> cfg_system_prompt: "";
    in-out property <bool> cfg_thinking_enabled: true;
    in-out property <string> cfg_thinking_intensity: "medium";
    in-out property <bool> cfg_multimodal_vision: true;

    // LLM Connection Test
    in-out property <bool> is_testing_llm: false;
    in-out property <string> llm_test_status: "";
    in-out property <bool> llm_test_is_error: false;
    in-out property <string> llm_test_raw_error: "";
    in-out property <bool> error_dialog_open: false;
    in-out property <string> error_dialog_title: "";
    in-out property <string> error_dialog_message: "";
    in-out property <string> error_copy_btn_text: "复制错误信息";

    callback copy_to_clipboard(string);

    // Agent, Skill & MCP Properties
    in-out property <string> cfg_security_level: "ask_confirm";
    in-out property <int> cfg_max_steps: 10;
    in-out property <bool> cfg_subtitle_tool_call_status: true;
    in-out property <bool> cfg_subtitle_thinking_status: false;
    in-out property <bool> cfg_live2d_thinking_enabled: true;
    in-out property <string> cfg_thinking_cue: "nod";
    in-out property <bool> cfg_live2d_tool_cue_enabled: false;
    in-out property <string> cfg_tool_cue: "nod";
    in-out property <[SkillItem]> skills: [];

    // Builtin Tools Properties
    in-out property <bool> cfg_builtin_use_skill: true;
    in-out property <bool> cfg_builtin_get_current_time: true;
    in-out property <bool> cfg_builtin_read_file: true;
    in-out property <bool> cfg_builtin_execute_command: true;
    in-out property <bool> cfg_builtin_take_screenshot: true;
    in-out property <bool> cfg_builtin_screenshot_save_to_disk: false;
    in-out property <bool> cfg_is_vision_model: true;

    // MCP Servers Properties & Form
    in-out property <[McpServerItem]> mcp_servers: [];
    in-out property <bool> mcp_add_dialog_open: false;
    in-out property <string> new_mcp_name: "";
    in-out property <string> new_mcp_transport: "stdio";
    in-out property <string> new_mcp_command: "";
    in-out property <string> new_mcp_args: "";
    in-out property <string> new_mcp_url: "";

    in-out property <string> loaded_skills_summary: "已扫描本地技能库";
    in-out property <string> loaded_mcp_summary: "MCP 状态：就绪";

    callback reload_skills_clicked();
    callback refresh_mcp_clicked();
    callback toggle_mcp_server(string, bool);
    callback delete_mcp_server(string);
    callback add_mcp_server(string, string, string, string, string);


    // Live2D & Dynamic Cues Properties
    in-out property <string> cfg_model_path: "Murasame_live2d/Murasame.model3.json";
    in-out property <string> cfg_neutral_expression: "neutral.exp3";
    in-out property <float> cfg_expression_timeout: 5.0;
    in-out property <float> cfg_motion_fade_out: 0.25;
    in-out property <bool> cfg_idle_motion_enabled: true;
    in-out property <string> cfg_idle_motion_target: "Idle";
    in-out property <float> cfg_idle_motion_interval: 30.0;
    in-out property <int> cfg_fps: 60;
    in-out property <int> cfg_idle_fps: 30;
    in-out property <float> cfg_supersample: 2.0;
    in-out property <bool> idle_dropdown_open: false;

    // Available resources
    in-out property <[string]> available_expressions: [];
    in-out property <[string]> available_motion_groups: [];
    in-out property <[string]> available_motions: [];

    // Form inputs for creating / editing CUE
    in-out property <string> edit_cue_name: "";
    in-out property <string> edit_cue_expression: "";
    in-out property <string> edit_cue_motion: "";
    in-out property <string> edit_cue_motion_group: "";

    // Dropdown open states for top form
    in-out property <bool> form_exp_open: false;
    in-out property <bool> form_motion_open: false;
    in-out property <bool> form_group_open: false;

    // Configured cue list
    in-out property <[CueItem]> cue_list: [];

    // Gaze tracking properties
    in-out property <bool> cfg_gaze_enabled: true;
    in-out property <float> cfg_gaze_idle_timeout: 2.5;
    in-out property <bool> cfg_gaze_blend_with_motions: true;
    in-out property <bool> cfg_gaze_pause_in_fullscreen: true;

    // Proactive speaking properties
    in-out property <bool> cfg_proactive_enabled: false;
    in-out property <float> cfg_proactive_min_interval: 15.0;
    in-out property <float> cfg_proactive_max_interval: 45.0;
    in-out property <string> cfg_proactive_prompt: "";

    // UI & Subtitles
    in-out property <bool> cfg_toolbar_enabled: true;
    in-out property <bool> cfg_subtitle_enabled: true;
    in-out property <bool> cfg_subtitle_bubble_enabled: false;
    in-out property <int> cfg_subtitle_font_size: 19;
    in-out property <string> cfg_subtitle_color: "#ffffff";
    in-out property <int> cfg_subtitle_y_offset: 0;
    in-out property <bool> cfg_mouse_passthrough: false;
    in-out property <bool> cfg_always_on_top: true;
    in-out property <bool> cfg_auto_hide_in_fullscreen: false;

    // Callbacks
    callback save_clicked();
    callback cancel_clicked();

    callback select_voice(string);
    callback filter_voices_changed(string);
    callback preview_tts();

    callback browse_beatrice_folder();
    callback reload_beatrice_model();
    callback select_beatrice_speaker(int);

    callback select_model(string);
    callback filter_models_changed(string);
    callback fetch_models_from_api(string, string);
    callback test_llm_connection(string, string, string);

    callback browse_model_file();
    callback export_live2d_config();
    callback import_live2d_config();

    // Live2D Cue Actions
    callback save_cue_form();
    callback clear_cue_form();
    callback edit_cue(int);
    callback remove_cue(int);
    callback preview_cue(int);
    callback preview_expression_name(string);
    callback preview_motion_name(string);
    callback preview_motion_group_name(string);

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // Tab Navigation Bar with Character Avatar at the Left and Tabs Centered
        HorizontalLayout {

            // Character Switcher (Avatar Only, stick to the left)
            char_avatar_btn := Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                border-width: 2px;
                border-color: root.char_dropdown_open ? #659fae : (char_avatar_touch.has-hover ? #ffffff66 : #ffffff24);
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                    source: root.editing_char_avatar;
                }

                if char_avatar_touch.has-hover : Rectangle {
                    background: #ffffff22;
                }

                char_avatar_touch := TouchArea {
                    clicked => { root.char_dropdown_open = !root.char_dropdown_open; }
                }
            }

            // Tab Buttons Centered in Remaining Space
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 8px;

                tab_btn_0 := Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: root.active_tab == 0 ? #659fae : (tab_touch_0.has-hover ? #ffffff18 : #ffffff0a);
                    tab_touch_0 := TouchArea {
                        clicked => {
                            root.active_tab = 0;
                            root.voice_dropdown_open = false;
                            root.model_dropdown_open = false;
                            root.speaker_dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        alignment: center;
                        Text {
                            text: "语音与TTS";
                            color: root.active_tab == 0 ? #ffffff : #cccccc;
                            font-size: 13px;
                            font-weight: root.active_tab == 0 ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                }

                tab_btn_1 := Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: root.active_tab == 1 ? #659fae : (tab_touch_1.has-hover ? #ffffff18 : #ffffff0a);
                    tab_touch_1 := TouchArea {
                        clicked => {
                            root.active_tab = 1;
                            root.voice_dropdown_open = false;
                            root.model_dropdown_open = false;
                            root.speaker_dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        alignment: center;
                        Text {
                            text: "AI对话模型";
                            color: root.active_tab == 1 ? #ffffff : #cccccc;
                            font-size: 13px;
                            font-weight: root.active_tab == 1 ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                }

                tab_btn_2 := Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: root.active_tab == 2 ? #659fae : (tab_touch_2.has-hover ? #ffffff18 : #ffffff0a);
                    tab_touch_2 := TouchArea {
                        clicked => {
                            root.active_tab = 2;
                            root.voice_dropdown_open = false;
                            root.model_dropdown_open = false;
                            root.speaker_dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        alignment: center;
                        Text {
                            text: "Live2D与动作";
                            color: root.active_tab == 2 ? #ffffff : #cccccc;
                            font-size: 13px;
                            font-weight: root.active_tab == 2 ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #ffffff25;
                    }
                }

                tab_btn_3 := Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: root.active_tab == 3 ? #659fae : (tab_touch_3.has-hover ? #ffffff18 : #ffffff0a);
                    tab_touch_3 := TouchArea {
                        clicked => {
                            root.active_tab = 3;
                            root.voice_dropdown_open = false;
                            root.model_dropdown_open = false;
                            root.speaker_dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        alignment: center;
                        Text {
                            text: "界面与字幕";
                            color: root.active_tab == 3 ? #ffffff : #cccccc;
                            font-size: 13px;
                            font-weight: root.active_tab == 3 ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                }

                tab_btn_4 := Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: root.active_tab == 4 ? #659fae : (tab_touch_4.has-hover ? #ffffff18 : #ffffff0a);
                    tab_touch_4 := TouchArea {
                        clicked => {
                            root.active_tab = 4;
                            root.voice_dropdown_open = false;
                            root.model_dropdown_open = false;
                            root.speaker_dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        alignment: center;
                        Text {
                            text: "用户偏好";
                            color: root.active_tab == 4 ? #ffffff : #cccccc;
                            font-size: 13px;
                            font-weight: root.active_tab == 4 ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                }

                tab_btn_5 := Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: root.active_tab == 5 ? #659fae : (tab_touch_5.has-hover ? #ffffff18 : #ffffff0a);
                    tab_touch_5 := TouchArea {
                        clicked => {
                            root.active_tab = 5;
                            root.voice_dropdown_open = false;
                            root.model_dropdown_open = false;
                            root.speaker_dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        alignment: center;
                        Text {
                            text: "Agent与技能";
                            color: root.active_tab == 5 ? #ffffff : #cccccc;
                            font-size: 13px;
                            font-weight: root.active_tab == 5 ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Right spacer balancer to keep tabs centered
            Rectangle {
                width: 36px;
                height: 36px;
            }
        }

        Rectangle { height: 1px; background: #659fae33; }

        // 2. Tab Contents in ScrollView

        Rectangle { height: 1px; background: #659fae33; }

        // 2. Tab Contents in ScrollView
        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-on;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                padding-right: 28px;
                padding-bottom: 20px;
                spacing: 16px;
                alignment: start;

                if root.active_tab == 0 : TabVoice {
                    cfg_tts_enabled <=> root.cfg_tts_enabled;
                    tts_preview_status <=> root.tts_preview_status;
                    tts_preview_is_error <=> root.tts_preview_is_error;
                    cfg_voice <=> root.cfg_voice;
                    voice_dropdown_open <=> root.voice_dropdown_open;
                    voice_list: root.voice_list;
                    cfg_tts_rate <=> root.cfg_tts_rate;
                    cfg_tts_pitch <=> root.cfg_tts_pitch;
                    cfg_tts_volume <=> root.cfg_tts_volume;
                    cfg_beatrice_enabled <=> root.cfg_beatrice_enabled;
                    cfg_beatrice_model_path <=> root.cfg_beatrice_model_path;
                    speaker_dropdown_open <=> root.speaker_dropdown_open;
                    current_speaker_name <=> root.current_speaker_name;
                    cfg_speaker_id <=> root.cfg_speaker_id;
                    beatrice_speakers: root.beatrice_speakers;
                    cfg_pitch_shift <=> root.cfg_pitch_shift;
                    cfg_formant_shift <=> root.cfg_formant_shift;
                    cfg_volume <=> root.cfg_volume;

                    filter_voices_changed(v) => { root.filter_voices_changed(v); }
                    preview_tts => { root.preview_tts(); }
                    select_voice(v) => { root.select_voice(v); }
                    browse_beatrice_folder => { root.browse_beatrice_folder(); }
                    reload_beatrice_model => { root.reload_beatrice_model(); }
                    select_beatrice_speaker(idx) => { root.select_beatrice_speaker(idx); }
                }

                if root.active_tab == 1 : TabLlm {
                    is_testing_llm: root.is_testing_llm;
                    cfg_api_protocol <=> root.cfg_api_protocol;
                    cfg_hermes_url <=> root.cfg_hermes_url;
                    cfg_hermes_key <=> root.cfg_hermes_key;
                    cfg_hermes_model <=> root.cfg_hermes_model;
                    cfg_openai_url <=> root.cfg_openai_url;
                    cfg_openai_key <=> root.cfg_openai_key;
                    cfg_openai_model <=> root.cfg_openai_model;
                    llm_test_status: root.llm_test_status;
                    llm_test_is_error: root.llm_test_is_error;
                    llm_test_raw_error: root.llm_test_raw_error;
                    model_dropdown_open <=> root.model_dropdown_open;
                    model_presets: root.model_presets;
                    cfg_context_window <=> root.cfg_context_window;
                    cfg_compression_strategy <=> root.cfg_compression_strategy;
                    cfg_thinking_enabled <=> root.cfg_thinking_enabled;
                    cfg_thinking_intensity <=> root.cfg_thinking_intensity;
                    cfg_multimodal_vision <=> root.cfg_multimodal_vision;
                    cfg_system_prompt <=> root.cfg_system_prompt;

                    test_llm_connection(u, k, m) => { root.test_llm_connection(u, k, m); }
                    fetch_models_from_api(u, k) => { root.fetch_models_from_api(u, k); }
                    filter_models_changed(f) => { root.filter_models_changed(f); }
                    select_model(m) => { root.select_model(m); }
                    show_error_dialog(t, m) => {
                        root.error_dialog_title = t;
                        root.error_dialog_message = m;
                        root.error_copy_btn_text = "复制错误信息";
                        root.error_dialog_open = true;
                    }
                }

                if root.active_tab == 2 : TabLive2d {
                    cfg_model_path <=> root.cfg_model_path;
                    cfg_neutral_expression <=> root.cfg_neutral_expression;
                    cfg_idle_motion_enabled <=> root.cfg_idle_motion_enabled;
                    cfg_idle_motion_target <=> root.cfg_idle_motion_target;
                    idle_dropdown_open <=> root.idle_dropdown_open;
                    available_motion_groups: root.available_motion_groups;
                    cfg_idle_motion_interval <=> root.cfg_idle_motion_interval;
                    cfg_expression_timeout <=> root.cfg_expression_timeout;
                    cfg_motion_fade_out <=> root.cfg_motion_fade_out;
                    cfg_fps <=> root.cfg_fps;
                    cfg_idle_fps <=> root.cfg_idle_fps;
                    cfg_supersample <=> root.cfg_supersample;
                    cfg_gaze_enabled <=> root.cfg_gaze_enabled;
                    cfg_gaze_idle_timeout <=> root.cfg_gaze_idle_timeout;
                    cfg_gaze_blend_with_motions <=> root.cfg_gaze_blend_with_motions;
                    cfg_gaze_pause_in_fullscreen <=> root.cfg_gaze_pause_in_fullscreen;
                    cfg_proactive_enabled <=> root.cfg_proactive_enabled;
                    cfg_proactive_min_interval <=> root.cfg_proactive_min_interval;
                    cfg_proactive_max_interval <=> root.cfg_proactive_max_interval;
                    cfg_proactive_prompt <=> root.cfg_proactive_prompt;
                    edit_cue_name <=> root.edit_cue_name;
                    edit_cue_expression <=> root.edit_cue_expression;
                    edit_cue_motion <=> root.edit_cue_motion;
                    edit_cue_motion_group <=> root.edit_cue_motion_group;
                    form_exp_open <=> root.form_exp_open;
                    form_motion_open <=> root.form_motion_open;
                    form_group_open <=> root.form_group_open;
                    available_expressions: root.available_expressions;
                    available_motions: root.available_motions;
                    cue_list: root.cue_list;

                    browse_model_file => { root.browse_model_file(); }
                    export_live2d_config => { root.export_live2d_config(); }
                    import_live2d_config => { root.import_live2d_config(); }
                    save_cue_form => { root.save_cue_form(); }
                    clear_cue_form => { root.clear_cue_form(); }
                    edit_cue(idx) => { root.edit_cue(idx); }
                    remove_cue(idx) => { root.remove_cue(idx); }
                    preview_cue(idx) => { root.preview_cue(idx); }
                    preview_expression_name(name) => { root.preview_expression_name(name); }
                    preview_motion_name(name) => { root.preview_motion_name(name); }
                    preview_motion_group_name(name) => { root.preview_motion_group_name(name); }
                }

                if root.active_tab == 3 : TabUi {
                    cfg_toolbar_enabled <=> root.cfg_toolbar_enabled;
                    cfg_subtitle_enabled <=> root.cfg_subtitle_enabled;
                    cfg_subtitle_bubble_enabled <=> root.cfg_subtitle_bubble_enabled;
                    cfg_subtitle_font_size <=> root.cfg_subtitle_font_size;
                    cfg_subtitle_color <=> root.cfg_subtitle_color;
                    cfg_subtitle_y_offset <=> root.cfg_subtitle_y_offset;
                    cfg_mouse_passthrough <=> root.cfg_mouse_passthrough;
                    cfg_always_on_top <=> root.cfg_always_on_top;
                    cfg_auto_hide_in_fullscreen <=> root.cfg_auto_hide_in_fullscreen;
                }

                if root.active_tab == 4 : TabUser {
                    cfg_user_avatar_enabled <=> root.cfg_user_avatar_enabled;
                    cfg_user_avatar: root.cfg_user_avatar;
                    browse_user_avatar => { root.browse_user_avatar(); }
                    reset_user_avatar => { root.reset_user_avatar(); }
                }

                if root.active_tab == 5 : TabAgent {
                    cfg_max_steps <=> root.cfg_max_steps;
                    cfg_subtitle_tool_call_status <=> root.cfg_subtitle_tool_call_status;
                    cfg_subtitle_thinking_status <=> root.cfg_subtitle_thinking_status;
                    cfg_live2d_thinking_enabled <=> root.cfg_live2d_thinking_enabled;
                    cfg_thinking_cue <=> root.cfg_thinking_cue;
                    cfg_live2d_tool_cue_enabled <=> root.cfg_live2d_tool_cue_enabled;
                    cfg_tool_cue <=> root.cfg_tool_cue;
                    cfg_builtin_use_skill <=> root.cfg_builtin_use_skill;
                    cfg_builtin_get_current_time <=> root.cfg_builtin_get_current_time;
                    cfg_builtin_read_file <=> root.cfg_builtin_read_file;
                    cfg_builtin_execute_command <=> root.cfg_builtin_execute_command;
                    cfg_builtin_take_screenshot <=> root.cfg_builtin_take_screenshot;
                    cfg_builtin_screenshot_save_to_disk <=> root.cfg_builtin_screenshot_save_to_disk;
                    cfg_multimodal_vision <=> root.cfg_multimodal_vision;
                    cfg_security_level <=> root.cfg_security_level;
                    mcp_servers: root.mcp_servers;
                    skills: root.skills;

                    open_add_mcp_dialog => {
                        root.new_mcp_name = "";
                        root.new_mcp_transport = "stdio";
                        root.new_mcp_command = "";
                        root.new_mcp_args = "";
                        root.new_mcp_url = "";
                        root.mcp_add_dialog_open = true;
                    }
                    refresh_mcp_clicked => { root.refresh_mcp_clicked(); }
                    toggle_mcp_server(name, en) => { root.toggle_mcp_server(name, en); }
                    delete_mcp_server(name) => { root.delete_mcp_server(name); }
                    reload_skills_clicked => { root.reload_skills_clicked(); }
                }
            }
        }
        // 3. Bottom Action Buttons
        Rectangle { height: 1px; background: #659fae33; }

        HorizontalLayout {
            spacing: 12px;
            alignment: end;

            Rectangle {
                width: 96px;
                height: 36px;
                border-radius: 6px;
                background: cancel_touch.has-hover ? #ffffff22 : #ffffff12;
                cancel_touch := TouchArea {
                    clicked => { root.cancel_clicked(); }
                }
                Text {
                    width: 100%; height: 100%;
                    text: "取消";
                    color: #cccccc;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 108px;
                height: 36px;
                border-radius: 6px;
                background: save_all_touch.has-hover ? #7bb5c4 : #659fae;
                save_all_touch := TouchArea {
                    clicked => { root.save_clicked(); }
                }
                Text {
                    width: 100%; height: 100%;
                    text: "保存并应用";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Modal Overlays
    if root.error_dialog_open : ErrorDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        title: root.error_dialog_title;
        message: root.error_dialog_message;
        copy_btn_text <=> root.error_copy_btn_text;
        close => { root.error_dialog_open = false; }
        copy_to_clipboard(text) => { root.copy_to_clipboard(text); }
    }

    if root.char_dropdown_open : CharacterDropdown {
        x: 0; y: 0; width: 100%; height: 100%;
        editing_char_id: root.editing_char_id;
        character_list: root.character_list;
        close => { root.char_dropdown_open = false; }
        select_character(id) => { root.select_editing_character(id); }
        open_create_dialog => {
            root.new_char_name = "";
            root.new_char_copy_current = true;
            root.create_char_dialog_open = true;
        }
        open_context_menu(x, y, id, name) => {
            root.char_menu_x = x;
            root.char_menu_y = y;
            root.target_menu_char_id = id;
            root.target_menu_char_name = name;
            root.char_context_menu_open = true;
        }
    }

    if root.char_context_menu_open : CharacterContextMenu {
        x: 0; y: 0; width: 100%; height: 100%;
        menu_x: root.char_menu_x;
        menu_y: root.char_menu_y;
        target_char_id: root.target_menu_char_id;
        target_char_name: root.target_menu_char_name;
        close => { root.char_context_menu_open = false; }
        open_rename_dialog => {
            root.char_dropdown_open = false;
            root.rename_char_input = root.target_menu_char_name;
            root.rename_char_dialog_open = true;
        }
        browse_avatar(id) => {
            root.browse_specific_char_avatar(id);
        }
        open_delete_dialog => {
            root.char_dropdown_open = false;
            root.delete_char_dialog_open = true;
        }
    }

    if root.rename_char_dialog_open : RenameCharacterDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        rename_input <=> root.rename_char_input;
        target_char_id: root.target_menu_char_id;
        close => { root.rename_char_dialog_open = false; }
        confirm_rename(id, name) => { root.rename_character(id, name); }
    }

    if root.create_char_dialog_open : CreateCharacterDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        new_name <=> root.new_char_name;
        copy_current <=> root.new_char_copy_current;
        close => { root.create_char_dialog_open = false; }
        confirm_create(id, name, copy) => { root.create_character(id, name, copy); }
    }

    if root.delete_char_dialog_open : DeleteCharacterDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        target_char_id: root.target_menu_char_id != "" ? root.target_menu_char_id : root.editing_char_id;
        target_char_name: root.target_menu_char_name != "" ? root.target_menu_char_name : root.editing_char_name;
        close => { root.delete_char_dialog_open = false; }
        confirm_delete(id) => { root.delete_character(id); }
    }

    if root.mcp_add_dialog_open : AddMcpDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        new_mcp_name <=> root.new_mcp_name;
        new_mcp_transport <=> root.new_mcp_transport;
        new_mcp_command <=> root.new_mcp_command;
        new_mcp_args <=> root.new_mcp_args;
        new_mcp_url <=> root.new_mcp_url;
        close => { root.mcp_add_dialog_open = false; }
        add_mcp_server(name, trans, cmd, args, url) => {
            root.add_mcp_server(name, trans, cmd, args, url);
        }
    }
}
