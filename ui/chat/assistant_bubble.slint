import { ChatMessageData } from "types.slint";

export component AssistantBubble inherits Rectangle {
    in property <ChatMessageData> msg;
    property <bool> is_expanded: false;
    callback right_clicked(length, length, string);

    background: #161726;
    border-width: 1px;
    border-color: #ffffff18;
    border-radius: 12px;

    // Background right-click touch area
    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                right_clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, msg.raw_text);
            }
        }
    }

    VerticalLayout {
        alignment: start;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;

        // If message has thought or tools: render the collapsible accordion card
        if msg.has_thought || msg.has_tools : Rectangle {
            background: #10111a;
            border-width: 1px;
            border-color: #ffffff12;
            border-radius: 8px;

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 6px;

                // Collapsible header row
                Rectangle {
                    height: 24px;

                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 13px;
                                    height: 13px;
                                    source: msg.has_tools ? @image-url("../../assets/icons/tool.svg") : @image-url("../../assets/icons/sparkles.svg");
                                }
                            }

                            Text {
                                text: msg.has_tools && msg.has_thought ? (msg.tools_summary + " · 思考过程") : (msg.has_tools ? msg.tools_summary : "思考过程");
                                color: #8f92a3;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 12px;
                                height: 12px;
                                source: is_expanded ? @image-url("../../assets/icons/chevron_up.svg") : @image-url("../../assets/icons/chevron_down.svg");
                            }
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            is_expanded = !is_expanded;
                        }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                right_clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, msg.raw_text);
                            }
                        }
                    }
                }

                // Expanded content body
                if is_expanded : VerticalLayout {
                    spacing: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: #ffffff10;
                    }

                    // Thought section
                    if msg.has_thought : VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../../assets/icons/sparkles.svg");
                                }
                            }
                            Text {
                                text: "思考过程";
                                color: #727588;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            background: #0d0e17;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #ffffff0a;

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;

                                Text {
                                    text: msg.thought_text;
                                    color: #9da0b5;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                        right_clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, msg.raw_text);
                                    }
                                }
                            }
                        }
                    }

                    // Tools detail section
                    if msg.has_tools : VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../../assets/icons/tool.svg");
                                }
                            }
                            Text {
                                text: "工具调用与结果";
                                color: #727588;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            background: #090a10;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #659fae25;

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;

                                Text {
                                    text: msg.tools_detail;
                                    color: #8ed0e0;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                        right_clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, msg.raw_text);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Response styled text
        if msg.raw_text != "" : Rectangle {
            StyledText {
                width: 100%;
                text: msg.content;
                default-color: #e2e4f0;
                default-font-size: 14px;
            }

            TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                        right_clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, msg.raw_text);
                    }
                }
            }
        }
    }
}

