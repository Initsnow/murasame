import { Button, LineEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Murasame Desktop Pet";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    preferred-width: 600px;
    preferred-height: 750px;

    in-out property <image> pet_texture;
    in-out property <string> subtitle_text: "";
    in-out property <bool> subtitle_visible: false;
    in-out property <float> subtitle_opacity: 1.0;
    
    in-out property <bool> input_expanded: false;
    in-out property <string> input_text: "";
    in-out property <bool> is_loading: false;
    in-out property <bool> settings_open: false;

    // Config bindings
    in-out property <string> cfg_api_url: "http://localhost:11434/v1";
    in-out property <string> cfg_api_key: "ollama";
    in-out property <string> cfg_model: "hermes-3";
    in-out property <string> cfg_voice: "zh-CN-XiaoyiNeural";
    in-out property <bool> cfg_beatrice_enabled: true;

    callback pet_clicked(length, length);
    callback prompt_submitted(string);
    callback settings_saved();
    callback exit_app();

    // 1. Live2D Viewport with drag and click
    pet_touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.pet_clicked(self.mouse-x, self.mouse-y);
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.pet_texture;
        }
    }

    // 2. Pure anime/galgame stroke-shadow subtitle (floating, transparent, non-blocking)
    if root.subtitle_visible && root.subtitle_text != "" : Rectangle {
        x: 20px;
        y: 40px;
        width: root.width - 40px;
        background: transparent;
        opacity: root.subtitle_opacity;

        animate opacity {
            duration: 300ms;
            easing: ease-in-out;
        }

        // Drop shadow texts for high contrast on any wallpaper
        Text {
            x: 1px;
            y: 1px;
            width: parent.width;
            text: root.subtitle_text;
            color: #000000cc;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            x: -1px;
            y: -1px;
            width: parent.width;
            text: root.subtitle_text;
            color: #000000cc;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            x: 1px;
            y: -1px;
            width: parent.width;
            text: root.subtitle_text;
            color: #000000cc;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            x: -1px;
            y: 1px;
            width: parent.width;
            text: root.subtitle_text;
            color: #000000cc;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        // Main white text
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            text: root.subtitle_text;
            color: #ffffff;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // 3. Floating Collapsible Input Bar & Action Pill
    Rectangle {
        x: root.input_expanded ? 20px : root.width - 90px;
        y: root.height - 70px;
        width: root.input_expanded ? root.width - 40px : 70px;
        height: 46px;
        border-radius: 23px;
        background: #1e1e24dd;
        border-width: 1px;
        border-color: #ffffff22;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;

        animate width { duration: 250ms; easing: ease-out; }
        animate x { duration: 250ms; easing: ease-out; }

        if !root.input_expanded : TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.input_expanded = true; }

            Text {
                width: 100%;
                height: 100%;
                text: "💬";
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.input_expanded : HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 8px;
            alignment: center;

            input_field := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: root.is_loading ? "思考与说话中..." : "和丛雨聊聊天...";
                text <=> root.input_text;
                enabled: !root.is_loading;
                accepted => {
                    if root.input_text != "" {
                        root.prompt_submitted(root.input_text);
                        root.input_text = "";
                        root.input_expanded = false;
                    }
                }
            }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: #ffffff18;

                TouchArea {
                    clicked => {
                        if root.input_text != "" {
                            root.prompt_submitted(root.input_text);
                            root.input_text = "";
                            root.input_expanded = false;
                        }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "➤";
                        color: #ffffff;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: #ffffff18;

                TouchArea {
                    clicked => { root.input_expanded = false; }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "✕";
                        color: #ffffffaa;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // 4. Quick Toolbar / Settings Toggle Icon
    Rectangle {
        x: root.width - 50px;
        y: 16px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: #1e1e2499;
        border-width: 1px;
        border-color: #ffffff22;

        TouchArea {
            clicked => { root.settings_open = !root.settings_open; }
            Text {
                width: 100%;
                height: 100%;
                text: "⚙";
                font-size: 16px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // 5. Settings Modal Dialog
    if root.settings_open : Rectangle {
        x: 30px;
        y: 80px;
        width: root.width - 60px;
        height: 480px;
        border-radius: 16px;
        background: #181920f2;
        border-width: 1px;
        border-color: #ffffff33;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000aa;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                Text {
                    text: "配置与设置";
                    font-size: 18px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-stretch: 1;
                }
                TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.settings_open = false; }
                    Text {
                        text: "✕";
                        color: #ffffffaa;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text { text: "API Base URL:"; color: #cccccc; font-size: 12px; }
            LineEdit { text <=> root.cfg_api_url; }

            Text { text: "API Key:"; color: #cccccc; font-size: 12px; }
            LineEdit { text <=> root.cfg_api_key; }

            Text { text: "LLM Model:"; color: #cccccc; font-size: 12px; }
            LineEdit { text <=> root.cfg_model; }

            Text { text: "TTS Voice:"; color: #cccccc; font-size: 12px; }
            LineEdit { text <=> root.cfg_voice; }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Beatrice 变声驱动:";
                    color: #cccccc;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: root.cfg_beatrice_enabled ? "已开启" : "已关闭";
                    clicked => { root.cfg_beatrice_enabled = !root.cfg_beatrice_enabled; }
                }
            }

            Rectangle { height: 10px; }

            HorizontalLayout {
                spacing: 12px;
                Button {
                    text: "保存并应用";
                    primary: true;
                    clicked => {
                        root.settings_saved();
                        root.settings_open = false;
                    }
                }
                Button {
                    text: "退出程序";
                    clicked => { root.exit_app(); }
                }
            }
        }
    }
}
